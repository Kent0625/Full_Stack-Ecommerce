DATABASE_URL=sqlite:///./thrift_main.sqlite
REPORTING_DATABASE_URL=sqlite:///./thrift_reporting.sqlite
JWT_SECRET_KEY=replace_with_a_long_random_secret_for_local_development
JWT_EXPIRES_SECONDS=86400
FRONTEND_URL=http://localhost:3000
# Optional. If omitted, local development uses an in-memory Redis mock.
REDIS_URL=

# Hostinger/PostgreSQL example:
# DATABASE_URL=postgresql://thrift_user:change_this_password@localhost:5432/thrift_store
# REPORTING_DATABASE_URL=postgresql://thrift_user:change_this_password@localhost:5432/thrift_reporting
